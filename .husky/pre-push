#!/usr/bin/env sh
# Load nvm if available (needed for VS Code git integration which doesn't load shell profile)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
# Switch to the Node version specified in .nvmrc
nvm use 2>/dev/null || true
# Pre-push hook: Run all quality checks before pushing
# This ensures no broken code is pushed to the remote repository
# and helps guarantee Jenkins pipeline builds go green
echo "Running all quality checks (typecheck, lint, test, e2e, security audit)..."
npm run check:all || exit 1
echo "All checks passed! Pushing..."
